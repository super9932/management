# send-src 스크립트용 SMTP 설정 — 이 파일을 .env.local 로 복사해 값을 채운다.
# .env.local 은 .gitignore 로 커밋되지 않는다 (시크릿 — S-01/E-03).

# Kakao Mail SMTP.
# 465 implicit TLS 만 열려 있다 (587 은 닫혀 있음) → SMTP_SECURE=true 필수.
# 사전 준비: 카카오메일 웹 > 환경설정 > IMAP/SMTP 사용 '켜기'.
SMTP_HOST=smtp.kakao.com
SMTP_PORT=465
SMTP_SECURE=true
# 카카오메일 주소 전체(@kakao.com 포함).
SMTP_USER=your-account@kakao.com
# 카카오계정 비밀번호가 아니라 IMAP/SMTP 설정에서 발급한 전용 비밀번호.
SMTP_PASS=your-imap-smtp-password
# 발신자 표기 (생략 시 SMTP_USER). 카카오는 From 이 인증 계정과 다르면 거부하므로
# 비워두거나 SMTP_USER 와 동일한 주소만 넣는다. 수신처(to)는 실행 인자로 지정한다.
MAIL_FROM=

# --- NAB API 서버 ---
# 지정하면 NAB API를 이 오리진으로 직접 호출한다(스테이징 등). 비우면 same-origin /api.
NEXT_PUBLIC_NAB_SERVER_URL=https://nxl-nab-stg.hanwhalife.com

# --- NAB API 인증 키 (x-api-header) ---
# 모든 NAB API 요청에 이 값이 x-api-header 로 실린다. 없으면 서버가 403 을 준다.
# dev / stg / prd 값이 다르다 — 위 서버 URL 과 짝을 맞춰 넣을 것.
# 실제 키는 저장소에 커밋하지 않는다. BE 담당자에게 환경별 값을 받아 .env.local 에만 채운다.
NEXT_PUBLIC_NAB_API_KEY=


# --- 목(MSW) 서버 ---
# 목데이터로 개발할 때만 true 로 켠다. 미지정/false 면 실서버로만 호출한다.
#
# 켜면 모든 API 를 브라우저 안에서 가로채므로 로그인·토큰이 아예 필요 없다.
# NEXT_PUBLIC_NAB_SERVER_URL 이 채워져 있어도 목 모드가 우선하므로 그대로 둬도 된다.
# 바꾼 뒤에는 dev 서버를 재시작할 것.
# VITE_USE_MSW=true
